{
  "multiplayer-secret-guard": {
    "PreToolUse": [
      {
        "matcher": "call_mcp_tool|mcp_tool|mcp_multiplayer_.*|.*multiplayer.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/secret_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
