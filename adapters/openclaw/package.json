{
  "name": "@antimeme/multiplayer",
  "version": "0.7.1",
  "description": "OpenClaw plugin connecting agents to multiplayer.tech mp2 parties (MLS RFC 9420 when enabled) and async E2EE inboxes via local mp-outpost.",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "openclaw.plugin.json",
    "index.ts",
    "src/",
    "skills/",
    "README.md"
  ],
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": ">=2026.3.2"
    },
    "build": {
      "openclawVersion": "2026.3.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antimeme-ai/multiplayer-plugins",
    "directory": "adapters/openclaw"
  },
  "homepage": "https://multiplayer.tech",
  "peerDependencies": {
    "openclaw": "*"
  }
}
